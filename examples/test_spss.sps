IF (Q9 < 1 OR Q9 > 7) Q9 = $SYSMIS.
EXECUTE.

* ======================================================================
* SECTION 5: REVERSE SCORING TRANSFORMATIONS
* ======================================================================

* Reverse scoring for alliance_total scale
RECODE WAI_4 (1 = 7) (7 = 1).
  (2 = 6) (3 = 5) (4 = 4) (5 = 3) (6 = 2) 
RECODE WAI_10 (1 = 7) (7 = 1).
  (2 = 6) (3 = 5) (4 = 4) (5 = 3) (6 = 2) 
EXECUTE.

* ======================================================================
* SECTION 6: SCALE SCORE COMPUTATION
* ======================================================================

* Compute supervision_rapport scale (12 items)
COMPUTE supervision_rapport_total = SWAI_1 + SWAI_2 + SWAI_3 + SWAI_4 + SWAI_5 + SWAI_6 + SWAI_7 + SWAI_8 + SWAI_9 + SWAI_10 + SWAI_11 + SWAI_12.
COMPUTE supervision_rapport_mean = MEAN(SWAI_1, SWAI_2, SWAI_3, SWAI_4, SWAI_5, SWAI_6, SWAI_7, SWAI_8, SWAI_9, SWAI_10, SWAI_11, SWAI_12).
EXECUTE.

* Compute depersonalization scale (5 items)
COMPUTE depersonalization_total = Q10 + Q11 + Q12 + Q13 + Q14.
COMPUTE depersonalization_mean = MEAN(Q10, Q11, Q12, Q13, Q14).
EXECUTE.

* Compute alliance_total scale (12 items)
COMPUTE alliance_total_total = WAI_1 + WAI_2 + WAI_3 + WAI_4 + WAI_5 + WAI_6 + WAI_7 + WAI_8 + WAI_9 + WAI_10 + WAI_11 + WAI_12.
COMPUTE alliance_total_mean = MEAN(WAI_1, WAI_2, WAI_3, WAI_4, WAI_5, WAI_6, WAI_7, WAI_8, WAI_9, WAI_10, WAI_11, WAI_12).
EXECUTE.

* Compute peer_support scale (4 items)
COMPUTE peer_support_total = MSPSS_1 + MSPSS_2 + MSPSS_3 + MSPSS_4.
COMPUTE peer_support_mean = MEAN(MSPSS_1, MSPSS_2, MSPSS_3, MSPSS_4).
EXECUTE.

* Compute emotional_exhaustion scale (9 items)
COMPUTE emotional_exhaustion_total = Q1 + Q2 + Q3 + Q4 + Q5 + Q6 + Q7 + Q8 + Q9.
COMPUTE emotional_exhaustion_mean = MEAN(Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, Q9).
EXECUTE.

* ======================================================================
* END OF SYNTAX
* ======================================================================

* To verify data:
DESCRIPTIVES VARIABLES=
  supervision_rapport_mean depersonalization_mean alliance_total_mean peer_support_mean emotional_exhaustion_mean
  /STATISTICS=MEAN STDDEV MIN MAX.

* Reliability analysis example:
RELIABILITY
  /VARIABLES=
    SWAI_1 SWAI_2 SWAI_3 SWAI_4 SWAI_5 SWAI_6 SWAI_7 SWAI_8 SWAI_9 SWAI_10 SWAI_11 SWAI_12
  /SCALE('supervision_rapport') ALL
  /MODEL=ALPHA.
