IF (Q14 < 1 OR Q14 > 7) Q14 = $SYSMIS.
IF (WAI_1 < 1 OR WAI_1 > 7) WAI_1 = $SYSMIS.
IF (WAI_2 < 1 OR WAI_2 > 7) WAI_2 = $SYSMIS.
IF (WAI_3 < 1 OR WAI_3 > 7) WAI_3 = $SYSMIS.
