IF (WAI_7 < 1 OR WAI_7 > 7) WAI_7 = $SYSMIS.
IF (WAI_8 < 1 OR WAI_8 > 7) WAI_8 = $SYSMIS.
IF (WAI_9 < 1 OR WAI_9 > 7) WAI_9 = $SYSMIS.
IF (WAI_10 < 1 OR WAI_10 > 7) WAI_10 = $SYSMIS.
IF (WAI_11 < 1 OR WAI_11 > 7) WAI_11 = $SYSMIS.
IF (WAI_12 < 1 OR WAI_12 > 7) WAI_12 = $SYSMIS.
IF (MSPSS_1 < 1 OR MSPSS_1 > 7) MSPSS_1 = $SYSMIS.
IF (MSPSS_2 < 1 OR MSPSS_2 > 7) MSPSS_2 = $SYSMIS.
IF (MSPSS_3 < 1 OR MSPSS_3 > 7) MSPSS_3 = $SYSMIS.
IF (MSPSS_4 < 1 OR MSPSS_4 > 7) MSPSS_4 = $SYSMIS.
IF (Q1 < 1 OR Q1 > 7) Q1 = $SYSMIS.
IF (Q2 < 1 OR Q2 > 7) Q2 = $SYSMIS.
IF (Q3 < 1 OR Q3 > 7) Q3 = $SYSMIS.
IF (Q4 < 1 OR Q4 > 7) Q4 = $SYSMIS.
IF (Q5 < 1 OR Q5 > 7) Q5 = $SYSMIS.
